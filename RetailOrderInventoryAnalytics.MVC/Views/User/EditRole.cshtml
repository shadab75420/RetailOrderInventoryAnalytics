@model UpdateUserRoleViewModel
@{
    ViewData["Title"] = "Change User Role";
}
<!-- US13: User Management -->
<div class="card shadow mb-4 form-card">
    <div class="card-header py-3"><h6 class="m-0 font-weight-bold text-primary">Change Role</h6></div>
    <div class="card-body">
        <form asp-action="EditRole" method="post">
            <input asp-for="UserId" type="hidden" />
            <input asp-for="FullName" type="hidden" />
            <input asp-for="Username" type="hidden" />
            <input asp-for="CurrentRoleName" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="details-grid mb-4">
                <strong>Full Name</strong><span>@Model.FullName</span>
                <strong>Username</strong><span>@Model.Username</span>
                <strong>Current Role</strong><span><span class="badge badge-primary">@Model.CurrentRoleName</span></span>
            </div>
            <div class="form-group">
                <label asp-for="RoleName"></label>
                <select asp-for="RoleName" class="form-control">
                    <option value="Admin">Admin</option>
                    <option value="Manager">Manager</option>
                    <option value="Staff">Staff</option>
                </select>
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit"><i class="fas fa-save mr-1"></i>Save</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
