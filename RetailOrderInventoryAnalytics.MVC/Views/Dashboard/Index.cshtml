@model DashboardViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Dashboard";
    var lowStock = ViewBag.LowStockProducts as List<ProductViewModel> ?? new();
    var salesLabels = JsonSerializer.Serialize(Model.MonthlySalesTrend.Select(x => x.Month));
    var salesValues = JsonSerializer.Serialize(Model.MonthlySalesTrend.Select(x => x.TotalSales));
    var categoryLabels = JsonSerializer.Serialize(Model.CategoryDistribution.Select(x => x.CategoryName));
    var categoryValues = JsonSerializer.Serialize(Model.CategoryDistribution.Select(x => x.ProductCount));
    var username = Context.Session.GetString("Username") ?? "Admin";

    // Dynamic Low Stock Analytics Calculations
    var mostAffectedCategory = lowStock.GroupBy(x => x.CategoryName)
                                       .OrderByDescending(g => g.Count())
                                       .FirstOrDefault()?.Key ?? "None";
    var criticalCount = lowStock.Count(x => x.StockQuantity <= 2);
}

<!-- Welcome Banner Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm welcome-banner" style="background: linear-gradient(135deg, var(--card-bg) 0%, var(--gray-50) 100%); border-radius: 16px;">
            <div class="card-body p-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div class="mb-3 mb-lg-0">
                    <h1 class="font-weight-800 text-gray-900 mb-2" style="font-size: 1.85rem; letter-spacing: -0.025em; line-height: 1.2;">Good Morning, @username 👋</h1>
                    <p class="text-gray-500 mb-0 font-weight-500" style="font-size: 0.95rem; max-width: 600px;">Manage your inventory, suppliers, products and orders efficiently.</p>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <!-- Stat 1: Inventory Health -->
                    <div class="d-flex align-items-center bg-white px-3 py-2 border rounded-lg shadow-sm mr-2 mb-2" style="border-radius: 10px; background-color: var(--card-bg) !important; border-color: var(--gray-100) !important;">
                        <div class="rounded-circle bg-success-light d-flex align-items-center justify-content-center mr-2" style="width: 32px; height: 32px; color: var(--success); flex-shrink: 0;">
                            <i class="fas fa-heartbeat" style="font-size: 0.85rem;"></i>
                        </div>
                        <div>
                            <div class="text-gray-500 font-weight-600 text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Inventory Health</div>
                            <div class="font-weight-800 text-success" style="font-size: 0.95rem;">@(Model.TotalProducts > 0 ? (100 - (Model.LowStockProducts * 100 / Model.TotalProducts)) : 100)%</div>
                        </div>
                    </div>
                    <!-- Stat 2: Low Stock Alerts -->
                    <div class="d-flex align-items-center bg-white px-3 py-2 border rounded-lg shadow-sm mr-2 mb-2" style="border-radius: 10px; background-color: var(--card-bg) !important; border-color: var(--gray-100) !important;">
                        <div class="rounded-circle bg-danger-light d-flex align-items-center justify-content-center mr-2" style="width: 32px; height: 32px; color: var(--danger); flex-shrink: 0;">
                            <i class="fas fa-exclamation-triangle" style="font-size: 0.85rem;"></i>
                        </div>
                        <div>
                            <div class="text-gray-500 font-weight-600 text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Low Stock Alerts</div>
                            <div class="font-weight-800 text-danger" style="font-size: 0.95rem;">@Model.LowStockProducts</div>
                        </div>
                    </div>
                    <!-- Stat 3: Pending Reorders -->
                    <div class="d-flex align-items-center bg-white px-3 py-2 border rounded-lg shadow-sm mb-2" style="border-radius: 10px; background-color: var(--card-bg) !important; border-color: var(--gray-100) !important;">
                        <div class="rounded-circle bg-warning-light d-flex align-items-center justify-content-center mr-2" style="width: 32px; height: 32px; color: var(--warning); flex-shrink: 0;">
                            <i class="fas fa-sync" style="font-size: 0.85rem;"></i>
                        </div>
                        <div>
                            <div class="text-gray-500 font-weight-600 text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Pending Reorders</div>
                            <div class="font-weight-800 text-warning" style="font-size: 0.95rem;">@Model.LowStockProducts</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modern SaaS KPI Cards Grid - mb-3 instead of mb-4 for tight modern spacing -->
<div class="row">
    <!-- Total Products -->
    <div class="col-xl col-md-4 mb-3">
        <div class="card shadow h-100 card-dashboard border-0">
            <div class="card-body d-flex align-items-center">
                <div class="kpi-card">
                    <div style="min-width: 0; flex: 1;">
                        <div class="kpi-title text-truncate">Products</div>
                        <div class="kpi-value text-truncate">@Model.TotalProducts</div>
                    </div>
                    <div class="kpi-icon-wrapper kpi-icon-success">
                        <i class="fas fa-box"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Total Categories -->
    <div class="col-xl col-md-4 mb-3">
        <div class="card shadow h-100 card-dashboard border-0">
            <div class="card-body d-flex align-items-center">
                <div class="kpi-card">
                    <div style="min-width: 0; flex: 1;">
                        <div class="kpi-title text-truncate">Categories</div>
                        <div class="kpi-value text-truncate">@Model.TotalCategories</div>
                    </div>
                    <div class="kpi-icon-wrapper kpi-icon-info">
                        <i class="fas fa-tags"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Suppliers -->
    <div class="col-xl col-md-4 mb-3">
        <div class="card shadow h-100 card-dashboard border-0">
            <div class="card-body d-flex align-items-center">
                <div class="kpi-card">
                    <div style="min-width: 0; flex: 1;">
                        <div class="kpi-title text-truncate">Suppliers</div>
                        <div class="kpi-value text-truncate">@Model.TotalSuppliers</div>
                    </div>
                    <div class="kpi-icon-wrapper kpi-icon-secondary">
                        <i class="fas fa-truck"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Orders -->
    <div class="col-xl col-md-4 mb-3">
        <div class="card shadow h-100 card-dashboard border-0">
            <div class="card-body d-flex align-items-center">
                <div class="kpi-card">
                    <div style="min-width: 0; flex: 1;">
                        <div class="kpi-title text-truncate">Orders</div>
                        <div class="kpi-value text-truncate">@Model.TotalOrders</div>
                    </div>
                    <div class="kpi-icon-wrapper kpi-icon-warning">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock -->
    <div class="col-xl col-md-4 mb-3">
        <div class="card shadow h-100 card-dashboard border-0">
            <div class="card-body d-flex align-items-center">
                <div class="kpi-card">
                    <div style="min-width: 0; flex: 1;">
                        <div class="kpi-title text-truncate">Low Stock</div>
                        <div class="kpi-value text-truncate">@Model.LowStockProducts</div>
                    </div>
                    <div class="kpi-icon-wrapper kpi-icon-danger">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-xl-3 col-md-4 mb-3">
        <div class="card shadow h-100 card-dashboard border-0">
            <div class="card-body d-flex align-items-center">
                <div class="kpi-card">
                    <div style="min-width: 0; flex: 1;">
                        <div class="kpi-title text-truncate">Revenue</div>
                        <div class="kpi-value">@Model.TotalRevenue.ToString("C0")</div>
                    </div>
                    <div class="kpi-icon-wrapper kpi-icon-primary">
                        <i class="fas fa-credit-card"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row">
    <!-- Monthly Sales Trend Chart -->
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow mb-3 border-0">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
                <h6 class="m-0 font-weight-bold text-gray-900" style="font-size: 1.1rem;">Sales & order volume trend</h6>
                <span class="badge badge-live">Live Tracker</span>
            </div>
            <div class="card-body">
                <div class="chart-area">
                    <canvas id="salesTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Category Distribution Chart -->
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow mb-3 border-0">
            <div class="card-header py-3 bg-white border-bottom">
                <h6 class="m-0 font-weight-bold text-gray-900" style="font-size: 1.1rem;">Category breakdown</h6>
            </div>
            <div class="card-body">
                <div class="chart-pie pt-2">
                    <canvas id="categoryPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tables Section -->
<div class="row">
    <!-- Low Stock Table (with dynamic Analytics Summary to fix spacing issues) -->
    <div class="col-lg-7">
        <div class="card shadow mb-3 border-0">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
                <h6 class="m-0 font-weight-bold text-gray-900" style="font-size: 1.1rem;">Low Stock Products</h6>
                <span class="badge badge-warning" style="font-size: 0.725rem;">Inventory Status Indicator</span>
            </div>
            <div class="card-body d-flex flex-column justify-content-between h-100">
                <div class="table-responsive mb-3">
                    <table class="table table-hover" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Supplier</th>
                                <th>Current Stock</th>
                                <th>Reorder Level</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in lowStock)
                        {
                            <tr>
                                <td><span class="font-weight-600">@item.ProductName</span></td>
                                <td>@item.CategoryName</td>
                                <td>@item.SupplierName</td>
                                <td><span class="badge badge-danger">@item.StockQuantity</span></td>
                                <td>@item.ReorderLevel</td>
                            </tr>
                        }
                        @if (!lowStock.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-gray-500">
                                    <i class="fas fa-check-circle text-success mr-2"></i>All products are well stocked!
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <!-- Dynamic Low Stock Analytics Summary (Converted to individual mini KPI cards) -->
                <div class="mt-auto pt-3 border-top">
                    <h6 class="font-weight-700 text-gray-900 mb-3" style="font-size: 0.95rem; letter-spacing: -0.01em;">Low Stock Summary</h6>
                    <div class="row">
                        <!-- Critical Products -->
                        <div class="col-sm-6 col-xl-3 mb-2">
                            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background-color: var(--gray-50);">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-uppercase text-gray-500 font-weight-600 mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Critical Products</div>
                                        <div class="h5 mb-0 font-weight-800 text-danger">@criticalCount</div>
                                    </div>
                                    <div class="rounded-circle bg-danger-light d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; color: var(--danger); flex-shrink: 0;">
                                        <i class="fas fa-exclamation-circle" style="font-size: 0.85rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Reorder Required -->
                        <div class="col-sm-6 col-xl-3 mb-2">
                            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background-color: var(--gray-50);">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-uppercase text-gray-500 font-weight-600 mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Reorder Required</div>
                                        <div class="h5 mb-0 font-weight-800 text-warning">@lowStock.Count</div>
                                    </div>
                                    <div class="rounded-circle bg-warning-light d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; color: var(--warning); flex-shrink: 0;">
                                        <i class="fas fa-sync" style="font-size: 0.85rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Most Affected Category -->
                        <div class="col-sm-6 col-xl-3 mb-2">
                            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background-color: var(--gray-50);">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div style="min-width: 0; flex: 1;">
                                        <div class="text-uppercase text-gray-500 font-weight-600 mb-1 text-truncate" style="font-size: 0.7rem; letter-spacing: 0.05em;">Most Affected</div>
                                        <div class="h5 mb-0 font-weight-800 text-primary text-truncate" title="@mostAffectedCategory">@mostAffectedCategory</div>
                                    </div>
                                    <div class="rounded-circle bg-primary-light d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; color: var(--primary); flex-shrink: 0;">
                                        <i class="fas fa-folder-open" style="font-size: 0.85rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Total Low Stock Items -->
                        <div class="col-sm-6 col-xl-3 mb-2">
                            <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background-color: var(--gray-50);">
                                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="text-uppercase text-gray-500 font-weight-600 mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total Low Stock</div>
                                        <div class="h5 mb-0 font-weight-800 text-info">@lowStock.Count</div>
                                    </div>
                                    <div class="rounded-circle bg-info-light d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; color: var(--info); flex-shrink: 0;">
                                        <i class="fas fa-boxes" style="font-size: 0.85rem;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Recent Transactions Table -->
    <div class="col-lg-5">
        <div class="card shadow mb-3 border-0">
            <div class="card-header py-3 bg-white border-bottom">
                <h6 class="m-0 font-weight-bold text-gray-900" style="font-size: 1.1rem;">Recent Inventory Transactions</h6>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Type</th>
                                <th>Qty</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentTransactions)
                            {
                                <tr>
                                    <td><span class="font-weight-600">@item.ProductName</span></td>
                                    <td>
                                        @if (item.TransactionType == "IN")
                                        {
                                            <span class="badge bg-success">IN</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">OUT</span>
                                        }
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Line Chart: Sales Trend
            var salesCtx = document.getElementById('salesTrendChart').getContext('2d');
            var salesGradient = salesCtx.createLinearGradient(0, 0, 0, 180);
            salesGradient.addColorStop(0, 'rgba(37, 99, 235, 0.12)');
            salesGradient.addColorStop(1, 'rgba(37, 99, 235, 0.00)');

            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(salesLabels),
                    datasets: [{
                        label: 'Sales',
                        data: @Html.Raw(salesValues),
                        borderColor: '#2563eb',
                        backgroundColor: salesGradient,
                        borderWidth: 2.5,
                        pointRadius: 3,
                        pointBackgroundColor: '#2563eb',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointHoverRadius: 5,
                        pointHoverBackgroundColor: '#2563eb',
                        pointHoverBorderColor: '#ffffff',
                        pointHoverBorderWidth: 1.5,
                        lineTension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    legend: { display: false },
                    scales: {
                        xAxes: [{
                            gridLines: {
                                display: false,
                                drawBorder: false
                            },
                            ticks: {
                                fontFamily: "'Inter', sans-serif",
                                fontColor: '#94a3b8',
                                fontSize: 11,
                                padding: 8
                            }
                        }],
                        yAxes: [{
                            gridLines: {
                                color: 'rgba(148, 163, 184, 0.08)',
                                zeroLineColor: 'rgba(148, 163, 184, 0.08)',
                                drawBorder: false,
                                borderDash: [5, 5]
                            },
                            ticks: {
                                beginAtZero: true,
                                fontFamily: "'Inter', sans-serif",
                                fontColor: '#94a3b8',
                                fontSize: 11,
                                padding: 8
                            }
                        }]
                    },
                    tooltips: {
                        backgroundColor: '#0f172a',
                        titleFontFamily: "'Inter', sans-serif",
                        bodyFontFamily: "'Inter', sans-serif",
                        bodyFontColor: '#ffffff',
                        xPadding: 10,
                        yPadding: 10,
                        cornerRadius: 6,
                        displayColors: false
                    }
                }
            });

            // Doughnut Chart: Category Distribution
            var pieCtx = document.getElementById('categoryPieChart').getContext('2d');
            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(categoryLabels),
                    datasets: [{
                        data: @Html.Raw(categoryValues),
                        backgroundColor: ['#2563eb', '#10b981', '#06b6d4', '#f59e0b', '#ef4444', '#8b5cf6'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    cutoutPercentage: 75,
                    legend: {
                        position: 'bottom',
                        labels: {
                            fontFamily: "'Inter', sans-serif",
                            fontColor: '#94a3b8',
                            fontSize: 11,
                            boxWidth: 8,
                            usePointStyle: true,
                            padding: 12
                        }
                    },
                    tooltips: {
                        backgroundColor: '#0f172a',
                        titleFontFamily: "'Inter', sans-serif",
                        bodyFontFamily: "'Inter', sans-serif",
                        bodyFontColor: '#ffffff',
                        xPadding: 10,
                        yPadding: 10,
                        cornerRadius: 6,
                        displayColors: true
                    }
                }
            });
        });
    </script>
}
