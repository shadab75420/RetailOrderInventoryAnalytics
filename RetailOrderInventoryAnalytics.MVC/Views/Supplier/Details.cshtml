@model SupplierViewModel
@{
    ViewData["Title"] = "Supplier Details";
}
<div class="panel">
    <div class="details-grid">
        <strong>Supplier Id</strong><span>@Model.SupplierId</span>
        <strong>Name</strong><span>@Model.SupplierName</span>
        <strong>Contact</strong><span>@Model.ContactPerson</span>
        <strong>Phone</strong><span>@Model.PhoneNumber</span>
        <strong>Email</strong><span>@Model.Email</span>
    </div>
    <div class="mt-3"><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div>
</div>
