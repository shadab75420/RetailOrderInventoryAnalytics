@model IEnumerable<SupplierViewModel>
@{
    ViewData["Title"] = "Suppliers";
    var canManage = Context.Session.GetString("Role") is "Admin" or "Manager";
}
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Supplier List</h6>
        @if (canManage) { <a class="btn btn-primary btn-sm" asp-action="Create">Create</a> }
    </div>
    <div class="card-body"><div class="table-responsive">
        <table class="table table-bordered data-table" width="100%" cellspacing="0">
            <thead><tr><th>Name</th><th>Contact</th><th>Phone</th><th>Email</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierName</td><td>@item.ContactPerson</td><td>@item.PhoneNumber</td><td>@item.Email</td>
                    <td class="text-end">
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.SupplierId">Details</a>
                        @if (canManage) { <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.SupplierId">Edit</a> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
</div>
