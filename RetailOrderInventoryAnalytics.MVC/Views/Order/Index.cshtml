@model IEnumerable<OrderViewModel>
@{
    ViewData["Title"] = "Orders";
}
<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Order List</h2>
        <a class="btn btn-primary btn-sm" asp-action="Create">Create</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Order No.</th><th>Date</th><th>Status</th><th>Total</th><th>User Id</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OrderNumber</td><td>@item.OrderDate.ToString("yyyy-MM-dd")</td><td>@item.Status</td><td>@item.TotalAmount.ToString("C")</td><td>@item.UserId</td>
                    <td class="text-end"><a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.OrderId">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
